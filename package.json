{
  "name": "yugabyte",
  "version": "2.1.3",
  "description": "Yugabyte data source plugin for grafana",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e": "playwright test",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "spellcheck": "cspell -c cspell.config.json \"**/*.{ts,tsx,js,go,md,mdx,yml,yaml,json,scss,css}\"",
    "lint": "eslint --cache .",
    "lint:fix": "yarn run lint --fix && prettier --write --list-different .",
    "server": "docker compose up --build",
    "sign": "sign-plugin"
  },
  "author": "Grafana",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@changesets/cli": "3.0.2",
    "@grafana/eslint-config": "9.0.0",
    "@grafana/plugin-e2e": "3.12.0",
    "@grafana/sign-plugin": "3.3.3",
    "@grafana/tsconfig": "2.2.0",
    "@playwright/test": "1.63.0",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/node": "25.9.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "copy-webpack-plugin": "14.0.0",
    "cspell": "10.3.0",
    "css-loader": "7.1.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-webpack-plugin": "6.0.0",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "glob": "13.0.6",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "5.0.0",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "prettier": "3.9.6",
    "replace-in-file-webpack-plugin": "1.0.6",
    "sass": "1.104.0",
    "sass-loader": "17.0.1",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "terser-webpack-plugin": "5.6.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "webpack": "5.110.3",
    "webpack-cli": "7.2.3",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "0.6.2"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.2.1",
    "@grafana/i18n": "13.2.1",
    "@grafana/plugin-ui": "0.17.4",
    "@grafana/runtime": "13.2.1",
    "@grafana/schema": "13.2.1",
    "@grafana/ui": "13.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.9",
    "fast-uri": "4.1.4",
    "ip-address": "10.7.0",
    "js-yaml": "5.4.1",
    "minimatch": "10.2.6",
    "nanoid": "6.0.1"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24",
    "npm": ">=11.16.0"
  }
}
